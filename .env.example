# Supabase public client configuration.
# Leave empty with NEXT_PUBLIC_DEMO_MODE=true to run without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for administrative scripts. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Application URL used by auth redirects and deployments.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode works without Supabase keys.
NEXT_PUBLIC_DEMO_MODE=true
